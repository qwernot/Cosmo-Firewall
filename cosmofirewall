#!/usr/bin/env bash
# ==============================================================================
# cosmofirewall - Cosmo Firewall 全局命令行管理工具
# 用法: cosmofirewall [start|stop|restart|status|logs|port|reset-password|update|uninstall]
# ==============================================================================
set -e

SERVICE="cosmo-firewall"
INSTALL_DIR="/opt/cosmo-firewall"
CONF_FILE="/etc/cosmo-firewall/cosmofirewall.conf"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo -e "${RED}请使用 root 权限执行（例如: sudo cosmofirewall $*）${NC}"
        exit 1
    fi
}

cmd_start() {
    require_root start
    systemctl start "${SERVICE}"
    sleep 1
    if systemctl is-active --quiet "${SERVICE}"; then
        echo -e "${GREEN}✅ Cosmo Firewall 已启动${NC}"
    else
        echo -e "${RED}❌ 启动失败，请执行 cosmofirewall logs 查看原因${NC}"
        exit 1
    fi
}

cmd_stop() {
    require_root stop
    systemctl stop "${SERVICE}"
    echo -e "${YELLOW}🛑 Cosmo Firewall 已停止${NC}"
}

cmd_restart() {
    require_root restart
    systemctl restart "${SERVICE}"
    sleep 1
    if systemctl is-active --quiet "${SERVICE}"; then
        echo -e "${GREEN}✅ Cosmo Firewall 已重启并运行正常${NC}"
    else
        echo -e "${RED}❌ 重启失败，请执行 cosmofirewall logs 查看原因${NC}"
        exit 1
    fi
}

cmd_status() {
    local port="8090"
    if [ -f "${CONF_FILE}" ]; then
        port="$(grep -E '^PORT=' "${CONF_FILE}" | cut -d= -f2 || echo 8090)"
    fi
    echo -e "${CYAN}=== Cosmo Firewall 运行状态 ===${NC}"
    systemctl status "${SERVICE}" --no-pager -l | head -n 15 || true
    echo ""
    echo -e "🌐 面板端口: ${GREEN}${port}${NC}"
    if command -v ipset >/dev/null 2>&1; then
        local bl_cnt wl_cnt
        bl_cnt="$(ipset list cosmo_fw_blacklist 2>/dev/null | grep -cE '^[0-9]+\.' || true)"
        wl_cnt="$(ipset list cosmo_fw_whitelist 2>/dev/null | grep -cE '^[0-9]+\.' || true)"
        echo -e "🛡️  内核 ipset 拦截 IP 数: ${RED}${bl_cnt:-0}${NC} | 白名单数: ${GREEN}${wl_cnt:-0}${NC}"
    fi
}

cmd_logs() {
    journalctl -u "${SERVICE}" -f -n 80 --no-pager
}

cmd_port() {
    require_root port
    local new_port="$1"
    if [ -z "${new_port}" ]; then
        read -r -p "请输入新的 Web 面板端口 (1-65535): " new_port
    fi
    if ! [[ "${new_port}" =~ ^[0-9]+$ ]] || [ "${new_port}" -lt 1 ] || [ "${new_port}" -gt 65535 ]; then
        echo -e "${RED}端口无效: ${new_port}${NC}"
        exit 1
    fi
    mkdir -p "$(dirname "${CONF_FILE}")"
    if [ -f "${CONF_FILE}" ] && grep -q '^PORT=' "${CONF_FILE}"; then
        sed -i "s/^PORT=.*/PORT=${new_port}/" "${CONF_FILE}"
    else
        echo "PORT=${new_port}" >> "${CONF_FILE}"
    fi
    systemctl restart "${SERVICE}"
    echo -e "${GREEN}✅ 面板端口已修改为 ${new_port} 并重启生效${NC}"
}

cmd_reset_password() {
    require_root reset-password
    local uname new_pwd
    read -r -p "要重置的管理员用户名 [默认 admin]: " uname
    uname="${uname:-admin}"
    read -r -s -p "请输入新密码 (至少6位): " new_pwd
    echo ""
    if [ "${#new_pwd}" -lt 6 ]; then
        echo -e "${RED}密码长度不能少于 6 位${NC}"
        exit 1
    fi
    (
        cd "${INSTALL_DIR}"
        python3 -c "
import database
database.init_db()
conn = database.get_conn()
h = database.hash_password('${new_pwd}')
cur = conn.execute('UPDATE users SET password_hash = ? WHERE username = ?;', (h, '${uname}'))
if cur.rowcount == 0:
    import time
    conn.execute('INSERT INTO users (username, password_hash, created_at) VALUES (?, ?, ?);', ('${uname}', h, int(time.time())))
conn.commit()
conn.close()
print('OK')
"
    )
    echo -e "${GREEN}✅ 管理员 [${uname}] 密码已重置${NC}"
}

cmd_update() {
    require_root update
    if [ ! -d "${INSTALL_DIR}/.git" ]; then
        echo -e "${RED}未找到 ${INSTALL_DIR} Git 仓库，无法在线更新${NC}"
        exit 1
    fi
    echo -e "${CYAN}📦 正在拉取 Cosmo Firewall 最新版本...${NC}"
    git -C "${INSTALL_DIR}" fetch --all
    git -C "${INSTALL_DIR}" reset --hard origin/main
    chmod +x "${INSTALL_DIR}/start.sh" "${INSTALL_DIR}/install.sh" "${INSTALL_DIR}/cosmofirewall"
    cp -f "${INSTALL_DIR}/cosmofirewall" /usr/local/bin/cosmofirewall
    chmod +x /usr/local/bin/cosmofirewall
    systemctl restart "${SERVICE}"
    echo -e "${GREEN}✅ Cosmo Firewall 已更新至最新版本并重启完成${NC}"
}

cmd_uninstall() {
    require_root uninstall
    read -r -p "确认彻底卸载 Cosmo Firewall 并清理防火墙规则？(y/N): " confirm
    if [[ ! "${confirm}" =~ ^[Yy]$ ]]; then
        echo "已取消卸载"
        exit 0
    fi
    systemctl stop "${SERVICE}" 2>/dev/null || true
    systemctl disable "${SERVICE}" 2>/dev/null || true
    rm -f "/etc/systemd/system/${SERVICE}.service"
    systemctl daemon-reload 2>/dev/null || true

    # 清理内核 iptables & ipset 规则
    for chain in INPUT DOCKER-USER; do
        iptables -D "${chain}" -m set --match-set cosmo_fw_whitelist src -j ACCEPT 2>/dev/null || true
        iptables -D "${chain}" -m set --match-set cosmo_fw_blacklist src -j DROP 2>/dev/null || true
    done
    ip6tables -D INPUT -m set --match-set cosmo_fw_whitelist6 src -j ACCEPT 2>/dev/null || true
    ip6tables -D INPUT -m set --match-set cosmo_fw_blacklist6 src -j DROP 2>/dev/null || true
    ipset destroy cosmo_fw_blacklist 2>/dev/null || true
    ipset destroy cosmo_fw_whitelist 2>/dev/null || true
    ipset destroy cosmo_fw_blacklist6 2>/dev/null || true
    ipset destroy cosmo_fw_whitelist6 2>/dev/null || true

    rm -rf "${INSTALL_DIR}" "/etc/cosmo-firewall" /usr/local/bin/cosmofirewall
    echo -e "${GREEN}✅ Cosmo Firewall 已彻底卸载并恢复网络规则${NC}"
}

show_menu() {
    echo "=========================================="
    echo "🛡️  Cosmo Firewall 快捷管理菜单"
    echo "=========================================="
    echo "  1. 启动服务 (start)"
    echo "  2. 停止服务 (stop)"
    echo "  3. 重启服务 (restart)"
    echo "  4. 查看状态 (status)"
    echo "  5. 实时日志 (logs)"
    echo "  6. 修改面板端口 (port)"
    echo "  7. 重置管理员密码 (reset-password)"
    echo "  8. 在线更新 (update)"
    echo "  9. 卸载清理 (uninstall)"
    echo "  0. 退出"
    echo "=========================================="
    read -r -p "请选择操作 [0-9]: " choice
    case "${choice}" in
        1) cmd_start ;;
        2) cmd_stop ;;
        3) cmd_restart ;;
        4) cmd_status ;;
        5) cmd_logs ;;
        6) cmd_port "" ;;
        7) cmd_reset_password ;;
        8) cmd_update ;;
        9) cmd_uninstall ;;
        0) exit 0 ;;
        *) echo -e "${RED}无效选项${NC}" ;;
    esac
}

case "${1:-}" in
    start)          cmd_start ;;
    stop)           cmd_stop ;;
    restart)        cmd_restart ;;
    status)         cmd_status ;;
    logs)           cmd_logs ;;
    port)           cmd_port "${2:-}" ;;
    reset-password) cmd_reset_password ;;
    update)         cmd_update ;;
    uninstall)      cmd_uninstall ;;
    "")             show_menu ;;
    *)
        echo "用法: cosmofirewall {start|stop|restart|status|logs|port|reset-password|update|uninstall}"
        exit 1
        ;;
esac
